<Window x:Class="ScreenRecorder.App.ControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowActivated="False">
    <Border Background="#E61E1E1E" CornerRadius="8" Padding="8" MouseLeftButtonDown="OnDrag">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="Red" Margin="2,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TimerText" Foreground="White" FontFamily="Consolas" FontSize="16" Text="00:00:00" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="PauseBtn" Content="Pause" Padding="10,3" Margin="2" Click="OnPause"/>
            <Button Content="Stop" Padding="10,3" Margin="2" Click="OnStop"/>
            <Button x:Name="CamBtn" Content="Cam" Padding="10,3" Margin="2" Click="OnCam" Visibility="Collapsed" ToolTip="Move or resize the webcam"/>
            <ToggleButton x:Name="DrawBtn" Content="Draw" Padding="10,3" Margin="2" Click="OnDraw"/>
            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0" Width="50">
                <ProgressBar x:Name="SysMeter" Height="5" Maximum="1" Foreground="LimeGreen" ToolTip="System audio"/>
                <ProgressBar x:Name="MicMeter" Height="5" Maximum="1" Foreground="DeepSkyBlue" Margin="0,3,0,0" ToolTip="Microphone"/>
            </StackPanel>
            <TextBlock x:Name="SizeText" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="8,0,2,0" FontSize="11"/>
        </StackPanel>
    </Border>
</Window>
