<Window x:Class="ScreenRecorder.App.DrawPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowActivated="False">
    <Border Background="#E61E1E1E" CornerRadius="8" Padding="8" MouseLeftButtonDown="OnDrag">
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PenBtn" Content="Pen" GroupName="t" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="HlBtn" Content="Highlight" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="EraseBtn" Content="Eraser" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="LineBtn" Content="Line" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="ArrowBtn" Content="Arrow" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="RectBtn" Content="Rect" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="OvalBtn" Content="Oval" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <RadioButton x:Name="TextBtn" Content="Text" GroupName="t" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="2" Checked="OnTool"/>
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="8,0"/>
            <Slider x:Name="Thickness" Minimum="2" Maximum="20" Value="4" Width="80" VerticalAlignment="Center" ValueChanged="OnThickness" ToolTip="Thickness"/>
            <Button Content="Undo" Padding="8,3" Margin="6,2,2,2" Click="OnUndo"/>
            <Button Content="Redo" Padding="8,3" Margin="2" Click="OnRedo"/>
            <Button Content="Clear" Padding="8,3" Margin="2" Click="OnClear"/>
            <Button Content="Done" Padding="8,3" Margin="2" Click="OnDone"/>
        </StackPanel>
    </Border>
</Window>
