<Window x:Class="ScreenRecorder.App.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" Width="160" Height="160" ResizeMode="NoResize" ShowActivated="False">
    <Border Background="#CC1E1E1E" CornerRadius="80">
        <TextBlock x:Name="NumberText" Foreground="White" FontSize="84" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
