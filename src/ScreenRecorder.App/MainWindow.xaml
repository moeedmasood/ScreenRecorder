<Window x:Class="ScreenRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Recorder" Width="460" Height="840" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="TimerText" FontSize="32" FontFamily="Consolas" HorizontalAlignment="Center" Text="00:00:00"/>
        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,2,0,12" TextWrapping="Wrap"
                   Text="Ready (Ctrl+Shift+R to start/stop)"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="RecordButton" Content="Record" Width="80" Height="32" Margin="4" Click="OnRecordClick"/>
            <Button x:Name="PauseButton" Content="Pause" Width="80" Height="32" Margin="4" IsEnabled="False" Click="OnPauseClick"/>
            <Button x:Name="AboutButton" Content="About" Width="60" Height="32" Margin="4" Click="OnAboutClick"/>
            <ToggleButton x:Name="DrawButton" Content="Draw" Width="80" Height="32" Margin="4" Click="OnDrawClick" ToolTip="Ctrl+Shift+D"/>
        </StackPanel>

        <GroupBox Header="What to record" Margin="0,12,0,0" x:Name="TargetGroup">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeMonitor" Content="Full screen" IsChecked="True" Margin="0,0,14,0" Checked="OnModeChanged"/>
                    <RadioButton x:Name="ModeWindow" Content="Window" Margin="0,0,14,0" Checked="OnModeChanged"/>
                    <RadioButton x:Name="ModeRegion" Content="Region" Checked="OnModeChanged"/>
                </StackPanel>
                <ComboBox x:Name="MonitorCombo" Margin="0,8,0,0" ToolTip="Display to record"/>
                <DockPanel x:Name="WindowRow" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" Padding="8,2" Click="OnRefreshWindows"/>
                    <ComboBox x:Name="WindowCombo" DisplayMemberPath="Title"/>
                </DockPanel>
                <DockPanel x:Name="RegionRow" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="Select area..." Margin="6,0,0,0" Padding="8,2" Click="OnSelectRegion"/>
                    <TextBlock x:Name="RegionText" VerticalAlignment="Center" Text="No area selected"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Audio" Margin="0,8,0,0" x:Name="AudioGroup">
            <StackPanel Margin="6">
                <CheckBox x:Name="SystemAudioCheck" Content="Record system audio" IsChecked="True" Margin="0,0,0,4"/>
                <CheckBox x:Name="MicCheck" Content="Record microphone" IsChecked="True"/>
                <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" Margin="0,4,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="System" FontSize="11" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="SysMeter" Grid.Column="1" Height="8" Maximum="1" Foreground="LimeGreen"/>
                    <TextBlock Text="Mic" Grid.Row="1" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <ProgressBar x:Name="MicMeter" Grid.Row="1" Grid.Column="1" Height="8" Maximum="1" Foreground="LimeGreen" Margin="0,4,0,0"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Video" Margin="0,8,0,0" x:Name="VideoGroup">
            <WrapPanel Margin="6">
                <TextBlock Text="Frame rate" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="FpsCombo" Width="70" Margin="0,0,16,0"/>
                <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="QualityCombo" Width="100"/>
                <CheckBox x:Name="CursorCheck" Content="Cursor" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Countdown" Margin="16,0,4,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CountdownCombo" Width="50" VerticalAlignment="Center"/>
                <TextBlock Text="After saving" Margin="16,0,4,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="AfterSaveCombo" Width="110" VerticalAlignment="Center"/>
                <CheckBox x:Name="CompatCheck" Content="Compatibility" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Use if a fullscreen game records as a black screen"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Header="Webcam" Margin="0,8,0,0" x:Name="WebcamGroup">
            <StackPanel Margin="6">
                <DockPanel>
                    <CheckBox x:Name="WebcamCheck" Content="Show webcam in recording" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="CamShapeCombo" Width="90" Margin="0,0,10,0" ToolTip="Shape"/>
                        <CheckBox x:Name="MirrorCheck" Content="Mirror" IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <ComboBox x:Name="CameraCombo" DisplayMemberPath="Name" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CamSizeCombo" Width="100" Margin="0,0,16,0"/>
                    <TextBlock Text="Position" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CamCornerCombo" Width="110"/>
                </StackPanel>
                <ToggleButton x:Name="PreviewButton" Content="Preview camera" Margin="0,6,0,0" Padding="8,2" HorizontalAlignment="Left" Click="OnPreviewClick"/>
                <Image x:Name="PreviewImage" Height="120" Stretch="Uniform" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Margin="0,8,0,0" Foreground="Gray" FontSize="11"
                   Text="Hotkeys: Ctrl+Shift+R record/stop, Ctrl+Shift+P pause, Ctrl+Shift+D draw, Ctrl+Shift+X clear drawing"/>

        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Padding="8,2" Click="OnBrowseClick"/>
            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>
        <Button x:Name="OpenFolderButton" Content="Open last recording" Margin="0,10,0,0" IsEnabled="False" Click="OnOpenClick"/>
    </StackPanel>
</Window>
