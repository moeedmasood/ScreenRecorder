<Window x:Class="ScreenRecorder.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About and licence" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="LicenseText" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,2" Text="Licence key"/>
        <TextBox x:Name="KeyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Activate" Padding="12,3" Click="OnActivate"/>
            <Button Content="Remove licence" Padding="12,3" Margin="6,0,0,0" Click="OnRemove"/>
        </StackPanel>
        <TextBlock x:Name="FeatureText" Margin="0,10,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="Free: 1080p, up to 30 fps. Pro adds 60 fps and the High quality preset (separate audio tracks and 4K/HEVC are planned)."/>
        <Separator Margin="0,12"/>
        <CheckBox x:Name="CrashCheck" Content="Send anonymous crash reports (off by default)" ToolTip="Reports contain only the error text and app/OS version. Never recordings or screen content."/>
        <CheckBox x:Name="UpdateCheck" Content="Check for updates at startup" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Export logs..." Padding="12,3" Click="OnExport"/>
            <Button Content="Open log folder" Padding="12,3" Margin="6,0,0,0" Click="OnOpenLogs"/>
            <Button Content="Close" Padding="12,3" Margin="6,0,0,0" IsCancel="True" IsDefault="True" Click="OnClose"/>
        </StackPanel>
    </StackPanel>
</Window>
